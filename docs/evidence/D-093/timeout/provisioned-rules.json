  {
    "id": 1,
    "uid": "peekcart-high-error-rate",
    "orgID": 1,
    "folderUID": "ag1tjrbazop34e",
    "ruleGroup": "PeekCart Alerts",
    "title": "High Error Rate (5xx > 5%)",
    "condition": "C",
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum by (application)(rate(http_server_requests_seconds_count{application=~\"gateway|notification-service|order-service|payment-service|product-service|user-service\", status=~\"5..\"}[5m]))",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "prometheus",
        "model": {
          "expr": "sum by (application)(rate(http_server_requests_seconds_count{application=~\"gateway|notification-service|order-service|payment-service|product-service|user-service\"}[5m]))",
          "instant": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "range": true
        }
      },
      {
        "refId": "C",
        "queryType": "",
        "relativeTimeRange": {
          "from": 300,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "expression": "($B > 0) && (($A / $B) * 100 > 5)",
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "type": "math"
        }
      }
    ],
    "updated": "2026-10-20T17:58:33Z",
    "noDataState": "NoData",
    "execErrState": "Alerting",
    "for": "2m",
    "annotations": {
      "description": "{{ $labels.application }} \uc758 \ucd5c\uadfc 5\ubd84\uac04 5xx \uc5d0\ub7ec\uc728\uc774 5%\ub97c \ucd08\uacfc\ud588\uc2b5\ub2c8\ub2e4.",
      "summary": "PeekCart 5xx \uc5d0\ub7ec\uc728 5% \ucd08\uacfc \u2014 {{ $labels.application }}"
    },
    "labels": {
      "severity": "critical"
    },
